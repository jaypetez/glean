# --- API server ---
# Path to the active feed config file.
GLEAN_CONFIG=/etc/glean/feeds.yaml
# Fixed API key for the web UI / API; leave blank to auto-generate one on first boot.
GLEAN_API_KEY=
# Set to 1/true/yes only for trusted local test deployments.
GLEAN_DISABLE_AUTH=
# Set to 1 to expose /api/docs and OpenAPI.
GLEAN_ENABLE_DOCS=
# Comma-separated browser origins allowed to open the SSE stream.
GLEAN_ALLOWED_ORIGINS=http://localhost:9090,http://127.0.0.1:9090
# Port for the API, web UI, and /healthz endpoint.
HEALTH_PORT=9090
# Max request body size in bytes for API uploads.
GLEAN_MAX_BODY_BYTES=1048576
# Max concurrent SSE subscribers before new connections are rejected.
GLEAN_MAX_SSE_SUBSCRIBERS=20
# GLEAN_INITIAL_API_KEY appears in startup logs on first boot; it is not read from env.
# GLEAN_INITIAL_API_KEY=<logged-on-first-boot>

# --- Storage ---
# SQLite state database path used by the CLI and daemon.
GLEAN_DB=/data/state.db
# Comma-separated allowlist of directories where SQLite DBs may live.
GLEAN_DB_ROOT=/data
# Comma-separated allowlist of directories the file sink may write to.
GLEAN_FILE_SINK_ROOTS=/data,/tmp/glean
# IANA timezone used for friendly schedules like `daily 09:00`.
TZ=UTC

# --- Logging ---
# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Set to `json` for structured logs; `text` matches local defaults.
LOG_FORMAT=text

# --- UI / test harness ---
# Override the built SPA asset directory (mainly for local dev and tests).
GLEAN_UI_DIST=
# Enables test-only reset endpoints; never set this in production.
GLEAN_TEST_MODE=
# Fixture config copied into GLEAN_CONFIG by the Playwright e2e harness.
GLEAN_TEST_CONFIG_FIXTURE=
# Empty fixture config copied into GLEAN_CONFIG by the Playwright e2e harness.
GLEAN_TEST_EMPTY_CONFIG_FIXTURE=
# PYTEST_CURRENT_TEST is set automatically by pytest; do not set it manually.
# PYTEST_CURRENT_TEST=<set-by-pytest>

# --- Telegram ---
# Bot token from BotFather.
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# Optional Telegram Bot API base URL for self-hosted Bot API servers or tests.
TELEGRAM_BASE_URL=
# Generic single-feed chat ID placeholder if your config uses ${TELEGRAM_CHAT_ID}.
# TELEGRAM_CHAT_ID=-1001234567890
# Chat IDs referenced from feeds.yaml — add as many as you have feeds.
TELEGRAM_CHAT_AI=-1001234567890
TELEGRAM_CHAT_SEC=-1001234567891
TELEGRAM_CHAT_HN=-1001234567892
TELEGRAM_OPS_CHAT_ID=-1001234567899

# --- LLM providers ---
# Conventional value to interpolate into llm.base_url for Ollama deployments.
OLLAMA_BASE_URL=http://ollama:11434
# Common alias if you prefer ${OLLAMA_HOST} in your local feeds.yaml.
OLLAMA_HOST=http://ollama:11434
# OpenAI API key, required when using the openai provider unless YAML supplies it.
OPENAI_API_KEY=
# Anthropic API key, required when using the anthropic provider unless YAML supplies it.
ANTHROPIC_API_KEY=

# --- Search backends ---
# Default search backend name for sources/search.py when YAML omits `engine`.
SEARCH_ENGINE=brave
# Brave Search API key.
BRAVE_API_KEY=
# Tavily API key.
TAVILY_API_KEY=
# Serper.dev API key.
SERPER_API_KEY=
# Exa API key.
EXA_API_KEY=
# Base URL for a self-hosted SearXNG instance.
SEARXNG_URL=
# Secret for the optional bundled SearXNG service.
SEARXNG_SECRET=

# --- Security ---
# Extra hostnames allowed through SSRF validation for trusted internal services.
GLEAN_SSRF_ALLOWED_HOSTS=

# --- Sinks (set the ones your feeds use) ---
# Discord incoming webhook URL.
DISCORD_WEBHOOK_URL=
# Slack incoming webhook URL.
SLACK_WEBHOOK_URL=
# Conventional ntfy topic name if your feeds.yaml interpolates one.
NTFY_TOPIC=
# Example bearer token placeholder for webhook sinks.
WEBHOOK_TOKEN=
