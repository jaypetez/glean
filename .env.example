# Required
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather

# Chat IDs referenced from feeds.yaml — add as many as you have feeds
TELEGRAM_CHAT_AI=-1001234567890
TELEGRAM_CHAT_SEC=-1001234567891
TELEGRAM_CHAT_HN=-1001234567892
TELEGRAM_OPS_CHAT_ID=-1001234567899

# LLM provider keys — only required if a feed in feeds.yaml uses that provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Search API keys — only required if a feed uses type: search
BRAVE_API_KEY=
TAVILY_API_KEY=

# Optional
TZ=UTC
LOG_LEVEL=INFO

# Required if using the optional SearXNG service (see docker-compose.yml)
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=
