#!/usr/local/bin/python3
from __future__ import annotations

import sys
import urllib.error
import urllib.request


def main() -> int:
    silent = False
    urls: list[str] = []
    for arg in sys.argv[1:]:
        if arg.startswith("-"):
            silent = "s" in arg
            continue
        urls.append(arg)

    if len(urls) != 1:
        sys.stderr.write("curl shim supports exactly one URL\n")
        return 2

    try:
        with urllib.request.urlopen(urls[0], timeout=10) as response:  # noqa: S310
            sys.stdout.buffer.write(response.read())
    except (TimeoutError, urllib.error.HTTPError, urllib.error.URLError) as exc:
        if not silent:
            sys.stderr.write(f"{exc}\n")
        return 22
    return 0


raise SystemExit(main())
