# Generated automatically by setup.sh / setup.ps1.
# DO NOT commit the resulting .env to version control.

# Required: 32+ hex characters. SearXNG refuses to start with a weaker secret.
# Generate one with: openssl rand -hex 32
SEARXNG_SECRET=

# Optional. Defaults to UTC.
TZ=UTC

# Optional. INFO is the default; set DEBUG if a feed is misbehaving.
LOG_LEVEL=INFO

# Optional. The API key for the glean management API on http://127.0.0.1:9091.
# Leave blank to let glean auto-generate one and print it to logs on first start.
# (For this example the API isn't strictly needed — the feed runs on a schedule.)
GLEAN_API_KEY=
