# Generated automatically by setup.sh / setup.ps1.
# DO NOT commit the resulting .env to version control.

# Required: 32+ hex characters. SearXNG refuses to start with a weaker secret.
# Generate one with: openssl rand -hex 32
SEARXNG_SECRET=

# Optional. Defaults to UTC.
TZ=UTC

# Optional. INFO is the default; set DEBUG if a feed is misbehaving.
LOG_LEVEL=INFO

# Optional. The API key for the glean management API on http://127.0.0.1:9091.
# Leave blank to let glean auto-generate one and print it to logs on first start.
# (For this example the API is not strictly needed - the feed runs on a schedule.)
GLEAN_API_KEY=

# Optional. Force the Ollama GPU mode instead of auto-detect.
# Values: none | nvidia | rocm | external
#   none     - CPU only (fine for qwen2.5:7b on modern hardware)
#   nvidia   - NVIDIA GPU via nvidia-container-toolkit
#   rocm     - AMD GPU via ROCm
#   external - Use Ollama running natively on your host (Mac users mostly)
GLEAN_OLLAMA_GPU=