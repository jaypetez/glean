# Required. Create a webhook in your Discord server:
#   Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Optional. Defaults to UTC.
TZ=UTC

# Optional. Defaults to INFO.
LOG_LEVEL=INFO

# Optional. Auto-generated and logged on first start if blank.
GLEAN_API_KEY=

# Optional. Force the Ollama GPU mode instead of auto-detect.
# Values: none | nvidia | rocm | external
GLEAN_OLLAMA_GPU=
