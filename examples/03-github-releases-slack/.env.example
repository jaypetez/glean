# Required. Create a Slack webhook:
#   1. Visit https://api.slack.com/apps and click "Create New App" -> "From scratch"
#   2. Add "Incoming Webhooks" feature, toggle ON
#   3. "Add New Webhook to Workspace" -> pick a channel -> copy the URL
SLACK_WEBHOOK_URL=

# Optional. Defaults to UTC.
TZ=UTC

# Optional. Defaults to INFO.
LOG_LEVEL=INFO

# Optional. Auto-generated and logged on first start if blank.
GLEAN_API_KEY=
