# Required. Pick any random string as your ntfy topic — anyone with this
# string can subscribe (and publish), so make it long and unguessable.
# Example: NTFY_TOPIC=glean-arxiv-7f3a9c2d1e8b
NTFY_TOPIC=glean-arxiv-CHANGE-ME

# Optional. Defaults to UTC.
TZ=UTC

# Optional. Defaults to INFO.
LOG_LEVEL=INFO

# Optional. Auto-generated and logged on first start if blank.
GLEAN_API_KEY=

# Optional. Force the Ollama GPU mode instead of auto-detect.
# Values: none | nvidia | rocm | external
GLEAN_OLLAMA_GPU=
