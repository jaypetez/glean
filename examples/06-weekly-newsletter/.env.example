# Default: Mailpit sidecar catches all email locally.
# To send to a real inbox, swap these to your provider's SMTP settings.
# See README.md for Gmail / Fastmail / AWS SES setup.

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_STARTTLS=true

# Optional
TZ=UTC
LOG_LEVEL=INFO
GLEAN_API_KEY=
